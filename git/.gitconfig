[user]
	name = ayoobf
	email = rflooivl@gmail.com
[init]
	defaultBranch = main
[core]
	excludesFile = ~/.gitignore_global
	pager = delta
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	side-by-side = true
[alias]
	st = status
	co = checkout
	lg = log --oneline --graph --decorate
	sync = "!f() { git add . && git commit -m \"$1\" && git push; }; f"
